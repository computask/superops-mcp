{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superops-api-call-log",
  "main": "diagnostics/worker.ts",
  "account_id": "c6dba133601075b447e306ebb826a33b",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "AUDIT_ENABLED": "true", "RETENTION_DAYS": "30" },
  "d1_databases": [{
    "binding": "API_CALL_LOG",
    "database_name": "superops-api-call-log",
    "database_id": "b12bebb1-fe47-4a9b-b09a-1226feaa8304",
    "migrations_dir": "migrations/api-call-log"
  }]
}
